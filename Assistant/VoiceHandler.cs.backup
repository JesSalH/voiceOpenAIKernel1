using System;
using System.Diagnostics;
#pragma warning disable OPENAI002
using OpenAI.RealtimeConversation;
#pragma warning restore OPENAI002
using Microsoft.Extensions.Logging;
using System.IO;
using System.Threading;
using System.Threading.Tasks;
using System.Linq;

namespace semanticKernelSample1.Assistant
{
    /// <summary>
    /// Voice recording and playback helper for the GPT Assistant
    /// </summary>
    public class VoiceHandler : IDisposable
    {
        private readonly ILogger _logger;
        private const string TEMP_AUDIO_FOLDER = "temp_audio";
        private readonly string _processId;
        private readonly AudioConfig _audioConfig;
        private bool _disposed = false;        public VoiceHandler(ILogger logger, AudioConfig? audioConfig = null)
        {
            _logger = logger ?? throw new ArgumentNullException(nameof(logger));
            _processId = Process.GetCurrentProcess().Id.ToString();
            _audioConfig = audioConfig ?? new AudioConfig();
            CreateAudioTempFolder();
            CleanupTempFiles();
        }

        // Finalizer as a safety net
        ~VoiceHandler()
        {
            Dispose(false);
        }

        // Implementation of IDisposable pattern
        public void Dispose()
        {
            Dispose(true);
            GC.SuppressFinalize(this);
        }

        protected virtual void Dispose(bool disposing)
        {
            if (!_disposed)
            {
                if (disposing)
                {
                    // Clean up managed resources
                    CleanupTempFiles();
                }

                // Always kill any sox processes
                KillSoxProcesses();
                _disposed = true;
            }
        }

        /// <summary>
        /// Creates a temporary folder for audio files if it doesn't exist
        /// </summary>
        private void CreateAudioTempFolder()
        {
            try
            {
                if (!Directory.Exists(TEMP_AUDIO_FOLDER))
                {
                    Directory.CreateDirectory(TEMP_AUDIO_FOLDER);
                    _logger.LogInformation("Created temporary audio folder: {FolderPath}", TEMP_AUDIO_FOLDER);
                }
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error creating temporary audio folder");
                // Continue without temp folder - will use current directory as fallback
            }
        }        /// <summary>
        /// Records audio from the user's microphone using sox
        /// </summary>
        /// <returns>Path to the recorded audio file</returns>
        public async Task<string> RecordAudioAsync(int maxRetries = 3)
        {
            var timestamp = DateTime.Now.ToString("yyyyMMddHHmmss");
            var tempFileName = $"temp_recording_{_processId}_{timestamp}.wav";
            var finalFileName = $"input_{_processId}_{timestamp}.wav";
            var tempAudioPath = Path.Combine(TEMP_AUDIO_FOLDER, tempFileName);
            var finalAudioPath = Path.Combine(TEMP_AUDIO_FOLDER, finalFileName);

            for (int attempt = 1; attempt <= maxRetries; attempt++)
            {
                try
                {
                    await RecordToTempFileAsync(tempAudioPath, attempt, maxRetries);
                    await MoveRecordingToFinalLocationAsync(tempAudioPath, finalAudioPath);
                    return finalAudioPath;
                }
                catch (Exception ex)
                {
                    _logger.LogError(ex, "Recording failed on attempt {Attempt}/{MaxRetries}", attempt, maxRetries);
                    if (attempt == maxRetries) 
                    {
                        throw new InvalidOperationException($"Recording failed after {maxRetries} attempts.", ex);
                    }
                    await Task.Delay(500 * attempt);
                }
            }
            throw new InvalidOperationException("Recording failed after all retries.");
        }

        private async Task RecordToTempFileAsync(string tempAudioPath, int attempt, int maxRetries)
        {
            // Ensure the temp folder exists
            if (!Directory.Exists(TEMP_AUDIO_FOLDER))
            {
                CreateAudioTempFolder();
            }

            _logger.LogInformation("Starting audio recording attempt {Attempt}/{MaxRetries}", attempt, maxRetries);
            
            using var soxProcess = new Process
            {
                StartInfo = new ProcessStartInfo
                {
                    FileName = "sox",
                    Arguments = $"-d {tempAudioPath}",
                    RedirectStandardOutput = true,
                    RedirectStandardError = true,
                    UseShellExecute = false,
                    CreateNoWindow = true,
                    WorkingDirectory = Directory.GetCurrentDirectory()
                }
            };

            try
            {
                soxProcess.Start();

                Console.WriteLine("Recording... Press Enter to stop.");
                Console.ReadLine();

                await TerminateSoxProcessAsync(soxProcess);
                _logger.LogInformation("Audio recorded successfully to temporary file");
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error recording audio with sox");
                Console.ForegroundColor = ConsoleColor.Red;
                Console.WriteLine($"Error recording audio: {ex.Message}");
                Console.ResetColor();
                throw;
            }
        }

        private async Task TerminateSoxProcessAsync(Process soxProcess)
        {
            if (!soxProcess.HasExited)
            {
                try
                {
                    // First try graceful termination
                    soxProcess.CloseMainWindow();
                    if (!soxProcess.WaitForExit(1000))
                    {
                        // Force kill if graceful doesn't work
                        soxProcess.Kill(true);
                        await soxProcess.WaitForExitAsync();
                    }
                }
                catch (Exception killEx)
                {
                    _logger.LogWarning(killEx, "Error terminating sox process");
                    // Try direct kill as last resort
                    try
                    {
                        soxProcess.Kill();
                        await soxProcess.WaitForExitAsync();
                    }
                    catch (Exception finalKillEx)
                    {
                        _logger.LogWarning(finalKillEx, "Final kill attempt failed - process might have already exited");
                    }
                }
            }

            // Extended delay to ensure file handles are released on Windows
            await Task.Delay(2000);
        }

        private async Task MoveRecordingToFinalLocationAsync(string tempPath, string finalPath)
        {
            // Wait a bit more to ensure sox has fully released the file
            await Task.Delay(1000);
            
            // Move/rename the file to break any lingering file handles
            try
            {
                File.Move(tempPath, finalPath);
                _logger.LogInformation("Moved recording from {TempPath} to {FinalPath}", tempPath, finalPath);
            }
            catch (Exception moveEx)
            {
                _logger.LogError(moveEx, "Failed to move recording file, attempting copy instead");
                // If move fails, try copy and delete
                try
                {
                    File.Copy(tempPath, finalPath);
                    await TryDeleteFileAsync(tempPath);
                }
                catch (Exception copyEx)
                {
                    _logger.LogError(copyEx, "Failed to copy recording file");
                    throw;
                }
            }
        }

        /// <summary>
        /// Converts the audio to the format expected by the OpenAI API
        /// </summary>
        /// <param name="inputPath">Path to the input audio file</param>
        /// <returns>Path to the converted audio file</returns>
        public async Task<string> ConvertAudioAsync(string inputPath)
        {
            try
            {
                var timestamp = DateTime.Now.ToString("yyyyMMddHHmmss");
                var outputFileName = $"converted_{_processId}_{timestamp}.wav";
                var outputPath = Path.Combine(TEMP_AUDIO_FOLDER, outputFileName);

                // Try to use temp folder, fall back to default if needed
                if (!Directory.Exists(TEMP_AUDIO_FOLDER))
                {
                    outputPath = "inputaudio.wav";
                    _logger.LogWarning("Using working directory for converted audio as fallback");
                }

                var arguments = $"{inputPath} -b {_audioConfig.BitsPerSample} -r {_audioConfig.SampleRate} -c {_audioConfig.Channels} {outputPath}";
                _logger.LogInformation("Converting audio with arguments: {Arguments}", arguments);
                var conversionProcess = new Process
                {
                    StartInfo = new ProcessStartInfo
                    {
                        FileName = "sox",
                        Arguments = arguments,
                        RedirectStandardOutput = true,
                        RedirectStandardError = true,
                        UseShellExecute = false,
                        CreateNoWindow = true,
                        WorkingDirectory = Directory.GetCurrentDirectory()
                    }
                };                Console.WriteLine("Converting audio to appropriate format...");
                conversionProcess.Start();
                await conversionProcess.WaitForExitAsync();

                // Dispose the process to ensure all handles are released
                conversionProcess.Dispose();

                // Ensure file handles are released with a longer delay
                await Task.Delay(1000);

                _logger.LogInformation("Audio converted successfully to {Path}", outputPath);
                return outputPath;
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error converting audio with sox");
                Console.ForegroundColor = ConsoleColor.Red;
                Console.WriteLine($"Error converting audio: {ex.Message}");
                Console.ResetColor();
                throw;
            }
        }        /// <summary>
        /// Sends the audio file to the OpenAI API for processing
        /// </summary>
        /// <param name="session">The conversation session</param>
        /// <param name="audioPath">Path to the audio file</param>
        #pragma warning disable OPENAI002
        public async Task SendAudioToSessionAsync(RealtimeConversationSession session, string audioPath)
        #pragma warning restore OPENAI002
        {
            try
            {
                if (!File.Exists(audioPath))
                {
                    throw new FileNotFoundException($"Audio file not found: {audioPath}");
                }

                // Get file info for logging and validation
                var fileInfo = new FileInfo(audioPath);
                if (fileInfo.Length == 0)
                {
                    _logger.LogWarning("Audio file {Path} is empty (0 bytes)", audioPath);
                    Console.ForegroundColor = ConsoleColor.Yellow;
                    Console.WriteLine("Warning: The audio file appears to be empty. The AI may not receive any content.");
                    Console.ResetColor();
                }
                else
                {
                    _logger.LogInformation("Sending audio file {Path} to session (size: {Size} bytes)", audioPath, fileInfo.Length);
                }

                // Use a higher timeout for large files
                int timeoutSeconds = (int)Math.Max(60, fileInfo.Length / 10000);
                
                // Create a cancellation token source with the calculated timeout
                using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(timeoutSeconds));                // Read audio file into memory first to avoid file locking issues
                byte[] audioData;
                using (var fileStream = new FileStream(audioPath, FileMode.Open, FileAccess.Read, FileShare.Read))
                {
                    audioData = new byte[fileStream.Length];
                    await fileStream.ReadExactlyAsync(audioData, 0, audioData.Length);
                }
                
                // Create memory stream from audio data - this prevents file locking
                using (var inputAudioStream = new MemoryStream(audioData))
                {
                    Console.WriteLine("Sending audio to AI assistant...");
                    
                    try
                    {
                        // Send the audio with a timeout to prevent hanging
                        var sendTask = session.SendInputAudioAsync(inputAudioStream);
                        
                        // Wait for completion or timeout
                        if (await Task.WhenAny(sendTask, Task.Delay(15000, cts.Token)) != sendTask)
                        {
                            _logger.LogWarning("Audio send operation is taking longer than expected");
                            Console.ForegroundColor = ConsoleColor.Yellow;
                            Console.WriteLine("Audio processing is taking longer than expected, but still continuing...");
                            Console.ResetColor();
                        }
                        
                        // Always await the task to ensure proper completion
                        await sendTask;
                    }
                    catch (OperationCanceledException)
                    {
                        _logger.LogError("Audio send operation timed out after {Seconds} seconds", timeoutSeconds);
                        Console.ForegroundColor = ConsoleColor.Red;
                        Console.WriteLine($"Audio processing timed out after {timeoutSeconds} seconds");
                        Console.ResetColor();
                        throw;
                    }
                }                Console.WriteLine("Processing your request...");
                
                // Longer delay to ensure audio processing is complete before starting response
                // This is critical for fixing the empty first message issue
                await Task.Delay(2000);
                
                // Start response processing
                await session.StartResponseAsync();

                Console.WriteLine("Waiting for assistant response...");
                _logger.LogInformation("Audio sent and response started successfully");
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error sending audio to AI: {ErrorMessage}", ex.Message);
                Console.ForegroundColor = ConsoleColor.Red;
                Console.WriteLine($"Error sending audio: {ex.Message}");
                Console.ResetColor();
                throw;
            }
        }

        /// <summary>
        /// Checks if sox is available on the system
        /// </summary>
        public bool IsSoxAvailable()
        {
            try
            {
                // First, try a direct approach - just execute sox with version flag
                using (var directProcess = new Process
                {
                    StartInfo = new ProcessStartInfo
                    {
                        FileName = "sox",
                        Arguments = "--version",
                        RedirectStandardOutput = true,
                        RedirectStandardError = true,
                        UseShellExecute = false,
                        CreateNoWindow = true
                    }
                })
                {
                    try
                    {
                        directProcess.Start();
                        directProcess.WaitForExit(1000); // Wait up to 1 second
                        return directProcess.ExitCode == 0;
                    }
                    catch
                    {
                        // Sox not directly accessible, continue with path check
                    }
                }

                // If direct check fails, try using where/which command
                string fileName = "where";
                string arguments = "sox";

                if (!OperatingSystem.IsWindows())
                {
                    fileName = "which";
                    arguments = "sox";
                }

                using (var process = new Process
                {
                    StartInfo = new ProcessStartInfo
                    {
                        FileName = fileName,
                        Arguments = arguments,
                        RedirectStandardOutput = true,
                        RedirectStandardError = true,
                        UseShellExecute = false,
                        CreateNoWindow = true
                    }
                })
                {
                    process.Start();
                    string output = process.StandardOutput.ReadToEnd();
                    process.WaitForExit();

                    return !string.IsNullOrEmpty(output);
                }
            }
            catch
            {
                return false;
            }
        }        /// <summary>
        /// Performs a complete audio recording and processing workflow
        /// </summary>
        #pragma warning disable OPENAI002
        public async Task RecordAndProcessAudioAsync(RealtimeConversationSession session)
        #pragma warning restore OPENAI002
        {
            try
            {
                _logger.LogInformation("Starting audio recording and processing workflow");
                
                // Visual indicator that recording is starting
                Console.ForegroundColor = ConsoleColor.Yellow;
                Console.WriteLine("Starting recording...");
                Console.ResetColor();
                
                // Record audio from microphone
                var inputAudioPath = await RecordAudioAsync();
                
                // Visual indicator that recording is complete
                Console.ForegroundColor = ConsoleColor.Green;
                Console.WriteLine("Recording successful!");
                Console.ResetColor();                // Convert audio to proper format
                var convertedAudioPath = await ConvertAudioAsync(inputAudioPath);
                
                // Give file handles more time to be released and ensure audio processing is ready
                await Task.Delay(1000);
                
                // Add visual feedback
                Console.ForegroundColor = ConsoleColor.Cyan;
                Console.WriteLine("Audio conversion successful! Sending to AI...");
                Console.ResetColor();

                // Send audio to OpenAI for processing
                await SendAudioToSessionAsync(session, convertedAudioPath);
                
                // Give more time for file operations to complete before cleanup
                await Task.Delay(1000);                try
                {
                    // Clean up the original file
                    await TryDeleteFileAsync(inputAudioPath);
                    await TryDeleteFileAsync(convertedAudioPath);
                }
                catch (Exception ex)
                {
                    // Just log the error but don't rethrow - file cleanup is not critical
                    _logger.LogWarning(ex, "Non-critical error cleaning up temporary audio files");
                }
                
                _logger.LogInformation("Workflow completed and temporary files cleaned up");
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error in audio recording and processing workflow");
                Console.ForegroundColor = ConsoleColor.Red;
                Console.WriteLine($"Error: {ex.Message}");
                Console.ResetColor();
                throw;
            }
        }        /// <summary>
        /// Attempts to delete a file with retries, logging warnings on failure but not throwing exceptions
        /// </summary>
        private async Task TryDeleteFileAsync(string filePath)
        {
            if (!File.Exists(filePath))
            {
                return;
            }
            
            const int maxRetries = 5; // Increased retries
            
            for (int retry = 0; retry < maxRetries; retry++)
            {
                try
                {
                    // Wait progressively longer between each retry
                    int delayMs = 500 * (retry + 1); // Increased delay
                    await Task.Delay(delayMs);
                    
                    // Use alternate method to force handle release only if we're having trouble
                    if (retry > 1)
                    {
                        // Using this technique sparingly avoids performance issues
                        try
                        {
                            using (var fs = new FileStream(filePath, FileMode.Open, FileAccess.ReadWrite, FileShare.Delete))
                            {
                                // Just opening and closing with proper sharing flags can help
                            }
                        }
                        catch
                        {
                            // If this fails, just continue with normal deletion attempt
                        }
                    }
                    
                    File.Delete(filePath);
                    _logger.LogDebug("Deleted temporary file: {Path}", filePath);
                    return;
                }
                catch (Exception ex) when (retry < maxRetries - 1)
                {
                    // Log but continue retrying
                    _logger.LogWarning(ex, "Could not delete temporary audio file {FilePath} (attempt {Attempt}/{MaxRetries})", 
                        filePath, retry + 1, maxRetries);
                }
                catch (Exception ex)
                {
                    // Log final failure but continue - this is not critical
                    _logger.LogWarning(ex, "Failed to delete temporary audio file {FilePath} after {MaxRetries} attempts", 
                        filePath, maxRetries);
                }
            }
        }        /// <summary>
        /// Kills all sox processes that might be running in the background
        /// </summary>
        public void KillSoxProcesses()
        {
            try
            {
                _logger.LogInformation("Looking for remaining sox processes to terminate...");
                var soxProcesses = Process.GetProcessesByName("sox");
                
                if (soxProcesses.Length > 0)
                {
                    _logger.LogInformation("Found {Count} sox processes to terminate", soxProcesses.Length);
                    
                    foreach (var process in soxProcesses)
                    {
                        try
                        {
                            if (!process.HasExited)
                            {
                                process.Kill(true); // Force kill with force parameter
                                process.WaitForExit(1000); // Wait up to 1 second for process to exit
                                _logger.LogInformation("Terminated sox process with ID: {ProcessId}", process.Id);
                            }
                            process.Dispose();
                        }
                        catch (Exception ex)
                        {
                            _logger.LogWarning(ex, "Failed to kill sox process (possibly already terminated)");
                        }
                    }
                }
                else
                {
                    _logger.LogDebug("No sox processes found to terminate");
                }
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error while trying to kill sox processes");
            }
        }/// <summary>
        /// Cleans up all temporary audio files from various locations
        /// </summary>
        public void CleanupTempFiles()
        {
            try
            {
                // First, kill any remaining sox processes to ensure files aren't locked
                KillSoxProcesses();
                
                var deletedCount = 0;

                // Define all locations to clean
                var cleanupLocations = new[]
                {
                    TEMP_AUDIO_FOLDER,
                    ".",
                    "bin\\Debug\\net9.0",
                    "bin\\Release\\net9.0",
                    "bin\\Debug",
                    "bin\\Release"
                };

                // Define patterns to match
                var patterns = new[] { "input_*.wav", "output*.wav", "converted_*.wav", "inputaudio.wav" };

                foreach (var location in cleanupLocations.Where(Directory.Exists))
                {
                    deletedCount += CleanupDirectory(location, patterns);
                }

                _logger.LogInformation("Temporary audio files cleanup completed. Deleted {Count} files.", deletedCount);
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error cleaning up temporary audio files");
            }
        }        /// <summary>
        /// Cleans up audio files in a specific directory using the given patterns
        /// </summary>
        private int CleanupDirectory(string directory, string[] patterns)
        {
            var deletedCount = 0;

            foreach (var pattern in patterns)
            {
                try
                {
                    var files = Directory.GetFiles(directory, pattern);
                    foreach (var file in files)
                    {
                        TryDeleteFileSync(file);
                        deletedCount++;
                    }
                }
                catch (Exception ex)
                {
                    _logger.LogWarning(ex, "Error cleaning files with pattern {Pattern} in {Directory}", pattern, directory);
                }
            }

            return deletedCount;
        }

        /// <summary>
        /// Synchronous version for cleanup operations to avoid deadlocks
        /// </summary>
        private void TryDeleteFileSync(string filePath)
        {
            if (!File.Exists(filePath))
            {
                return;
            }
            
            const int maxRetries = 3;
            
            for (int retry = 0; retry < maxRetries; retry++)
            {
                try
                {
                    // Wait between retries
                    if (retry > 0)
                    {
                        Thread.Sleep(200 * retry);
                    }
                    
                    File.Delete(filePath);
                    _logger.LogDebug("Deleted temporary file: {Path}", filePath);
                    return;
                }
                catch (Exception ex) when (retry < maxRetries - 1)
                {
                    // Log but continue retrying
                    _logger.LogWarning(ex, "Could not delete temporary audio file {FilePath} (attempt {Attempt}/{MaxRetries})", 
                        filePath, retry + 1, maxRetries);
                }
                catch (Exception ex)
                {
                    // Log final failure but continue - this is not critical
                    _logger.LogWarning(ex, "Failed to delete temporary audio file {FilePath} after {MaxRetries} attempts", 
                        filePath, maxRetries);
                }
            }
        }
    }

    public class AudioConfig
    {
        public int BitsPerSample { get; set; } = 16;
        public int SampleRate { get; set; } = 24000;
        public int Channels { get; set; } = 1;
    }
}